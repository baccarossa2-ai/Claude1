{
  "appId": "chat.cloudy.app",
  "appName": "Cloudy",
  "webDir": "www",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#07080f",
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#07080f",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "Keyboard": { "resize": "native" },
    "StatusBar": { "style": "DARK", "backgroundColor": "#07080f", "overlaysWebView": false }
  }
}
