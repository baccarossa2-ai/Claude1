<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is allowed so local providers (Ollama, LM Studio on the LAN) work. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
